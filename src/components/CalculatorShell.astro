---
import type { CalculatorDefinition } from '../data/calculators';
import { getCalculatorsByCategory, getCalculatorBySlug } from '../data/calculators';
import { CATEGORIES } from '../data/categories';
import CalculatorInteractive from './CalculatorInteractive.astro';

interface Props {
  calc: CalculatorDefinition;
}

const { calc } = Astro.props;

// Category sidebar rule: Every tool page shows navigation for ITS OWN category only!
// E.g. Sleep Calculator is Everyday, so its sidebar shows Everyday tools.
const categoryTools = getCalculatorsByCategory(calc.category);
const currentCategory = CATEGORIES[calc.category];

// Related calculators lookup
const relatedTools = calc.relatedSlugs
  .map(slug => getCalculatorBySlug(slug))
  .filter((t): t is CalculatorDefinition => t !== undefined);
---

<div class="container">
  <div class="tool-page-grid">
    <!-- Main Content Column -->
    <article class="prose">
      <!-- 2. One H1 only, matching the tool name people search for -->
      <h1>{calc.name}</h1>

      <!-- 3. Direct answer first: 2-3 plain sentences with answer in the first sentence -->
      <div class="direct-answer-lead" style="font-size: 1.15rem; line-height: 1.6; color: var(--color-slate-800); margin-bottom: 1.5rem; border-left: 3px solid var(--color-primary); padding-left: 1rem;">
        {calc.directAnswer}
      </div>

      <!-- 1. Tool ABOVE THE FOLD (Instant calculation, no sign-up, copy/share result) -->
      <section id="interactive-tool-section" aria-label={`Interactive ${calc.name}`}>
        <!-- If this is a hub page with tabs, show anchor tabs in plain HTML -->
        {calc.hubTabs && calc.hubTabs.length > 0 && (
          <nav class="hub-nav" aria-label="Tool Sections">
            {calc.hubTabs.map(tab => (
              <a href={`#${tab.id}`} class="hub-tab-btn">{tab.title}</a>
            ))}
          </nav>
        )}

        <CalculatorInteractive calc={calc} />
      </section>

      <!-- 4. Formula / Method in plain HTML (written out, every input explained) -->
      <section id="formula-method" aria-labelledby="heading-formula">
        <h2 id="heading-formula">Formula and Calculation Method</h2>
        <div set:html={calc.formulaHtml} />
      </section>

      <!-- 5. Worked Example with real numbers matching tool output -->
      <section id="worked-example" aria-labelledby="heading-worked-example">
        <h2 id="heading-worked-example">Worked Example and Step-by-Step Calculation</h2>
        <div class="example-card">
          <div class="example-card-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{calc.workedExample.title}</span>
          </div>

          <div style="font-size: 0.925rem; margin-bottom: 0.75rem;">
            <strong>Input Values:</strong>
            <ul style="margin-top: 0.35rem; margin-bottom: 0.75rem;">
              {Object.entries(calc.workedExample.inputs).map(([k, v]) => (
                <li><strong>{k}:</strong> {v}</li>
              ))}
            </ul>
          </div>

          <div style="font-size: 0.925rem; line-height: 1.5;" set:html={calc.workedExample.calculationHtml} />

          <div class="example-result-pill">
            Result: {calc.workedExample.result}
          </div>
        </div>
      </section>

      <!-- 6. How to Use It, Step by Step -->
      <section id="how-to-use" aria-labelledby="heading-how-to-use">
        <h2 id="heading-how-to-use">How to Use the {calc.name}</h2>
        <ol>
          {calc.steps.map(step => (
            <li>{step}</li>
          ))}
        </ol>
      </section>

      <!-- 7. Common Mistakes, Limitations & What to Do with the Result -->
      <section id="limitations-mistakes" aria-labelledby="heading-limitations">
        <h2 id="heading-limitations">Common Mistakes, Limitations & Practical Guidance</h2>
        <ul>
          {calc.limitations.map(lim => (
            <li>{lim}</li>
          ))}
        </ul>
      </section>

      <!-- 8. Frequently Asked Questions (Matching exact page name!) -->
      <section class="faq-section" aria-labelledby="heading-faqs">
        <h2 id="heading-faqs">Frequently Asked Questions About {calc.name}</h2>
        {calc.faqs.map(faq => (
          <article class="faq-item">
            <h3 class="faq-question">
              <span>{faq.question}</span>
            </h3>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </article>
        ))}
      </section>

      <!-- 9. Related Calculators (Internal links to adjacent tools) -->
      {relatedTools.length > 0 && (
        <section id="related-calculators" style="margin-top: 2.5rem;" aria-labelledby="heading-related">
          <h2 id="heading-related">Related Calculators</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1rem;">
            {relatedTools.map(rt => (
              <a href={`/${rt.slug}/`} style="display: block; background: var(--color-white); border: 1px solid var(--color-slate-200); border-radius: var(--radius-md); padding: 1rem; text-decoration: none; color: inherit; transition: all 0.15s ease;">
                <div style="font-weight: 700; color: var(--color-primary); font-size: 0.95rem; margin-bottom: 0.25rem;">{rt.name}</div>
                <div style="font-size: 0.825rem; color: var(--color-slate-600); line-height: 1.4;">{rt.shortDescription}</div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- 10. Sourced Data & Date Line (number + unit + source + date) -->
      <footer class="source-line">
        <strong>Sources & Verification:</strong>
        <ul style="list-style: none; padding-left: 0; margin-top: 0.5rem;">
          {calc.sources.map(src => (
            <li style="margin-bottom: 0.35rem;">
              • {src.claim} — <em>{src.source}</em> {src.url && <a href={src.url} target="_blank" rel="noopener noreferrer">(Official Source)</a>} [Checked: {src.date}]
            </li>
          ))}
        </ul>
      </footer>
    </article>

    <!-- Sidebar Column: Shows navigation for ITS OWN category only -->
    <aside class="sidebar" aria-label={`${currentCategory.name} Navigation`}>
      <div class="sidebar-card">
        <h3 class="sidebar-title">{currentCategory.name}</h3>
        <ul class="sidebar-list">
          {categoryTools.map(tool => (
            <li class="sidebar-item">
              <a
                href={`/${tool.slug}/`}
                class={`sidebar-link ${tool.slug === calc.slug ? 'active' : ''}`}
                aria-current={tool.slug === calc.slug ? 'page' : undefined}
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
        <div style="margin-top: 1.25rem; padding-top: 0.75rem; border-top: 1px solid var(--color-slate-100); text-align: center;">
          <a href={`/${currentCategory.slug}/`} style="font-size: 0.85rem; font-weight: 600;">
            View All {currentCategory.name} →
          </a>
        </div>
      </div>
    </aside>
  </div>
</div>
