# ==============================================================================
# AIO Calculator — LiteSpeed / OpenLiteSpeed / CloudPages Production Config
# Fully hardened security, LSCache, clean URLs & sub-millisecond static delivery
# ==============================================================================

# Default directory index file
DirectoryIndex index.html

# Prevent directory indexing
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Block access to hidden dotfiles, version control, environment and backup files
<FilesMatch "^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git|lock|map)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Follow symbolic links (standard requirement for rewrite engines)
<IfModule mod_rewrite.c>
  Options +FollowSymLinks
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Canonical 301 Redirect: Legacy Dice Roller to 1-to-100 Tool
  # ----------------------------------------------------------------------------
  RewriteRule ^free-online-dice-roller/?$ /free-online-dice-roller-1-to-100/ [R=301,L]

  # ----------------------------------------------------------------------------
  # 2. Enforce Canonical Trailing Slashes for Directories (Zero 404s, Zero Duplicate Slugs)
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # ----------------------------------------------------------------------------
  # 3. Canonical HTTPS Enforcement (Uncomment in production after SSL is active)
  # ----------------------------------------------------------------------------
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ https://aio-calculator.com/$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. LiteSpeed Cache (LSCache) Engine Directives
# Enables sub-millisecond edge response times on CloudPages LiteSpeed servers
# ------------------------------------------------------------------------------
<IfModule LiteSpeed>
  CacheLookup on
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} ^HEAD|GET$
  RewriteCond %{REQUEST_URI} !/(admin|login)
  RewriteRule .* - [E=Cache-Control:max-age=3600]
</IfModule>

# ------------------------------------------------------------------------------
# 5. Browser Caching & Expiration Policies
# Static Assets: 1 Year (31,536,000s) Public Immutable Cache
# HTML & Data: 1 Hour (3,600s) Revalidation Cache
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML pages — 1 hour revalidation
  ExpiresByType text/html "access plus 1 hour"

  # Data feeds & manifests
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"

  # Modular JavaScript & Stylesheets — 1 Year Immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Web Fonts — 1 Year Immutable
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Media, Vector & Bitmap Images — 1 Year Immutable
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML Cache-Control: fast revalidation
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>

  # Static Assets: immutable browser cache
  <FilesMatch "\.(css|js|webp|svg|jpg|jpeg|png|gif|ico|mp4|webm|woff2|woff|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # ----------------------------------------------------------------------------
  # 6. Hardened Security Headers (OWASP Top 10 Best Practices)
  # ----------------------------------------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; media-src 'self' https:; font-src 'self' data: https:; frame-ancestors 'self';"
  Header set X-XSS-Protection "1; mode=block"

  # HTTP Strict Transport Security (HSTS) on active HTTPS connections
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  </If>
</IfModule>

# ------------------------------------------------------------------------------
# 7. Gzip & Brotli HTTP Pre-compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
