---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allCalculators } from '../data/calculators';
import { CATEGORIES } from '../data/categories';

const categoriesList = Object.values(CATEGORIES);
---

<BaseLayout
  title="All Free Online Calculators — Complete 100+ Tool Directory | AIO Calculator"
  description="Search and browse our complete directory of 100+ free online calculators for finance, mortgages, loans, fitness, health, math, and everyday utility."
  canonicalPath="/all-tools/"
  schemaType="website"
>
  <div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <div style="max-width: 800px; margin-bottom: 2rem;">
      <h1 style="margin-bottom: 0.75rem;">All Online Calculators Directory</h1>
      <p style="font-size: 1.1rem; color: var(--color-slate-600); line-height: 1.6;">
        Explore all interactive tools across personal finance, body metrics, mathematics, and everyday utilities. Fast, client-side, and completely free.
      </p>
    </div>

    <!-- Live Directory Filter Bar -->
    <div style="background: var(--color-white); border: 1px solid var(--color-slate-200); border-radius: var(--radius-lg); padding: 1.25rem; margin-bottom: 2.5rem; box-shadow: var(--shadow-sm);">
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <input
          type="search"
          id="dir-search-input"
          class="form-input"
          style="flex: 1; min-width: 250px;"
          placeholder="Filter tools by name, topic, or formula (e.g. mortgage, BMI, GPA, tax)..."
        />
        <select id="dir-cat-filter" class="form-select" style="width: auto; min-width: 180px;">
          <option value="all">All Categories ({allCalculators.length})</option>
          {categoriesList.map(cat => (
            <option value={cat.id}>{cat.name}</option>
          ))}
        </select>
      </div>
      <div id="dir-results-counter" style="margin-top: 0.75rem; font-size: 0.85rem; color: var(--color-slate-500); font-weight: 500;">
        Showing {allCalculators.length} calculators
      </div>
    </div>

    <!-- Grouped Directory List -->
    <div id="dir-tools-container">
      {categoriesList.map((cat) => {
        const catTools = allCalculators.filter(c => c.category === cat.id);
        return (
          <section class="dir-category-section" data-cat={cat.id} style="margin-bottom: 3.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid var(--color-slate-200); padding-bottom: 0.5rem; margin-bottom: 1.25rem;">
              <h2 style="font-size: 1.45rem; margin: 0; color: var(--color-slate-900);">{cat.name}</h2>
              <a href={`/${cat.slug}/`} style="font-size: 0.85rem; font-weight: 600;">Category Overview →</a>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
              {catTools.map((tool) => (
                <a
                  href={`/${tool.slug}/`}
                  class="dir-tool-item"
                  data-name={tool.name.toLowerCase()}
                  data-desc={tool.shortDescription.toLowerCase()}
                  data-keywords={tool.secondaryKeywords.join(' ').toLowerCase()}
                  data-cat={tool.category}
                  style="background: var(--color-white); border: 1px solid var(--color-slate-200); border-radius: var(--radius-md); padding: 1.25rem; text-decoration: none; color: inherit; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between; transition: all 0.15s ease;"
                >
                  <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.35rem;">
                      <h3 style="font-size: 1.05rem; margin: 0; color: var(--color-slate-900);">{tool.name}</h3>
                      {tool.badge && (
                        <span style="font-size: 0.65rem; font-weight: 700; background: var(--color-slate-100); color: var(--color-slate-700); padding: 0.15rem 0.4rem; border-radius: var(--radius-sm);">
                          {tool.badge}
                        </span>
                      )}
                    </div>
                    <p style="font-size: 0.825rem; color: var(--color-slate-600); line-height: 1.4; margin-bottom: 0.75rem;">
                      {tool.shortDescription}
                    </p>
                  </div>
                  <span style="font-size: 0.825rem; font-weight: 600; color: var(--color-primary);">Open Calculator →</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('dir-search-input') as HTMLInputElement | null;
      const catFilter = document.getElementById('dir-cat-filter') as HTMLSelectElement | null;
      const counter = document.getElementById('dir-results-counter');
      const toolItems = document.querySelectorAll('.dir-tool-item');
      const catSections = document.querySelectorAll('.dir-category-section');

      // Check URL search parameters
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get('q');
      if (initialQuery && searchInput) {
        searchInput.value = initialQuery;
      }

      function applyFilter() {
        const query = searchInput?.value.toLowerCase().trim() || '';
        const selectedCat = catFilter?.value || 'all';

        let visibleCount = 0;

        catSections.forEach(section => {
          const sectionCat = section.getAttribute('data-cat');
          let sectionHasVisible = false;

          const items = section.querySelectorAll('.dir-tool-item');
          items.forEach(item => {
            const name = item.getAttribute('data-name') || '';
            const desc = item.getAttribute('data-desc') || '';
            const kw = item.getAttribute('data-keywords') || '';
            const cat = item.getAttribute('data-cat') || '';

            const matchesQuery = !query || name.includes(query) || desc.includes(query) || kw.includes(query);
            const matchesCat = selectedCat === 'all' || cat === selectedCat;

            if (matchesQuery && matchesCat) {
              (item as HTMLElement).style.display = 'flex';
              sectionHasVisible = true;
              visibleCount++;
            } else {
              (item as HTMLElement).style.display = 'none';
            }
          });

          if (sectionHasVisible) {
            (section as HTMLElement).style.display = 'block';
          } else {
            (section as HTMLElement).style.display = 'none';
          }
        });

        if (counter) {
          counter.textContent = `Showing ${visibleCount} calculators matching criteria`;
        }
      }

      searchInput?.addEventListener('input', applyFilter);
      catFilter?.addEventListener('change', applyFilter);

      applyFilter();
    });
  </script>
</BaseLayout>
