---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us — Feedback, Suggestions & Bug Reports | AIO Calculator"
  description="Contact the AIO Calculator engineering and editorial team for tool suggestions, calculation verification questions, or bug reports."
  canonicalPath="/contact-us/"
  schemaType="website"
>
  <div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <article class="prose" style="margin-left: auto; margin-right: auto;">
      <h1>Contact Us</h1>

      <p class="lead" style="font-size: 1.15rem; color: var(--color-slate-700); line-height: 1.6;">
        We welcome feedback, bug reports, and suggestions for new calculation tools. Our engineering team strives to make AIO Calculator the fastest, most reliable calculation resource on the web.
      </p>

      <div style="background: var(--color-white); border: 1.5px solid var(--color-slate-200); border-radius: var(--radius-lg); padding: 2rem; margin: 2rem 0; box-shadow: var(--shadow-sm);">
        <h2 style="margin-top: 0; font-size: 1.25rem;">Send Us a Message</h2>
        <form style="display: grid; gap: 1.25rem;" onsubmit="event.preventDefault(); alert('Thank you for your feedback! Our editorial team will review your message.');">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="contact-name">Your Name</label>
            <input type="text" id="contact-name" class="form-input" required placeholder="Jane Doe" />
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="contact-email">Email Address</label>
            <input type="email" id="contact-email" class="form-input" required placeholder="jane@example.com" />
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="contact-subject">Topic</label>
            <select id="contact-subject" class="form-select">
              <option value="feedback">General Feedback & Suggestion</option>
              <option value="bug">Report a Calculation Bug or Error</option>
              <option value="new-tool">Request a New Calculator</option>
              <option value="press">Editorial / Partnership Inquiry</option>
            </select>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="contact-message">Message</label>
            <textarea id="contact-message" class="form-input" rows="5" required placeholder="Please describe your question or suggestion in detail..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="justify-self: start;">Submit Message</button>
        </form>
      </div>

      <h2>Direct Electronic Inquiries</h2>
      <p>
        You can also reach our editorial and technical review team directly at:
      </p>
      <ul>
        <li><strong>Email:</strong> <code>support@aio-calculator.com</code></li>
        <li><strong>Response Time:</strong> We review all mathematical reports and calculation inquiries within 1 to 2 business days.</li>
      </ul>
    </article>
  </div>
</BaseLayout>
