---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogPostsBySlug } from '../data/blogPosts';

const post = blogPostsBySlug['how-to-use-a-mortgage-calculator'];
---

<BaseLayout
  title={post.metaTitle}
  description={post.metaDescription}
  canonicalPath={`/${post.slug}/`}
  schemaType="article"
  articleData={post}
>
  <div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <article class="prose" style="margin-left: auto; margin-right: auto;">
      <div style="font-size: 0.85rem; color: var(--color-slate-500); margin-bottom: 0.75rem;">
        Published: {post.publishDate} • Updated: {post.updateDate} • {post.readingTime}
      </div>

      <h1>{post.title}</h1>

      <div style="background-color: var(--color-primary-light); border-left: 4px solid var(--color-primary); padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 2rem;">
        <p style="margin: 0; font-size: 1.05rem; color: #1e3a8a; line-height: 1.5;">
          <strong>Quick Tool Access:</strong> Need to compute your monthly mortgage payment right now? Jump straight to our free <a href="/mortgage-calculator/">Interactive Mortgage Calculator</a> with live PITI and PMI breakdown.
        </p>
      </div>

      <div set:html={post.contentHtml} />

      <div style="margin-top: 3rem; padding: 1.5rem; background: var(--color-white); border: 1.5px solid var(--color-slate-200); border-radius: var(--radius-lg); text-align: center;">
        <h3 style="margin-top: 0; margin-bottom: 0.5rem;">Ready to Calculate Your Payments?</h3>
        <p style="color: var(--color-slate-600); margin-bottom: 1rem;">
          Test your numbers with our free, in-browser mortgage calculation engine.
        </p>
        <a href="/mortgage-calculator/" class="btn btn-primary">Open Free Mortgage Calculator →</a>
      </div>
    </article>
  </div>
</BaseLayout>
