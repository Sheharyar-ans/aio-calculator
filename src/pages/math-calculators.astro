---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../data/categories';
import { getCalculatorsByCategory } from '../data/calculators';

const category = CATEGORIES.math;
const tools = getCalculatorsByCategory('math');
---

<BaseLayout
  title={category.metaTitle}
  description={category.metaDescription}
  canonicalPath={`/${category.slug}/`}
  schemaType="website"
>
  <div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <div style="max-width: 800px; margin-bottom: 2.5rem;">
      <span style="font-size: 0.8rem; font-weight: 700; color: #7e22ce; text-transform: uppercase; letter-spacing: 0.05em;">Category Directory</span>
      <h1 style="margin-top: 0.5rem; margin-bottom: 1rem;">{category.name}</h1>
      <p style="font-size: 1.1rem; color: var(--color-slate-600); line-height: 1.6;">
        {category.description}
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      {tools.map((tool) => (
        <a href={`/${tool.slug}/`} style="background: var(--color-white); border: 1px solid var(--color-slate-200); border-radius: var(--radius-lg); padding: 1.5rem; text-decoration: none; color: inherit; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between; transition: all 0.15s ease;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
              <h2 style="font-size: 1.15rem; margin: 0; color: var(--color-slate-900);">{tool.name}</h2>
              {tool.badge && (
                <span style="font-size: 0.7rem; font-weight: 700; background: #f3e8ff; color: #7e22ce; padding: 0.15rem 0.45rem; border-radius: var(--radius-sm);">
                  {tool.badge}
                </span>
              )}
            </div>
            <p style="font-size: 0.875rem; color: var(--color-slate-600); line-height: 1.5; margin-bottom: 1.25rem;">
              {tool.shortDescription}
            </p>
          </div>
          <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-primary);">Open Calculator →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
