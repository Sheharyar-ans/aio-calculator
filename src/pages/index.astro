---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollWorldHero from '../components/ScrollWorldHero.astro';
import { CATEGORIES } from '../data/categories';
import {
  getCalculatorsByCategory,
  popularTools,
  tier1Tools,
  allCalculators
} from '../data/calculators';
import { blogPosts } from '../data/blogPosts';

const financeTools = getCalculatorsByCategory('financial');
const healthTools = getCalculatorsByCategory('health');
const mathTools = getCalculatorsByCategory('math');
const everydayTools = getCalculatorsByCategory('everyday');
---

<BaseLayout
  title="AIO Calculator — 100+ Free Online Calculators for Finance, Health & Math"
  description="Over 100 fast, free online calculators for mortgages, loans, taxes, BMI, calories, GPA, fractions, and everyday use. Instant client-side calculations with zero tracking."
  canonicalPath="/"
  schemaType="website"
>
  <!-- Scroll-World 5-Scene Hero (Diorama flight with instant H1, Search, and Popular Tools) -->
  <ScrollWorldHero />

  <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
    <!-- Tier 1 / New in 2026 Section -->
    <section class="home-section" aria-labelledby="heading-new-2026">
      <div class="section-header">
        <div>
          <span class="section-tag" style="background-color: #fef3c7; color: #b45309;">Updated for 2026</span>
          <h2 id="heading-new-2026" class="section-heading">High-Demand 2026 Calculators</h2>
        </div>
        <a href="/all-tools/" class="section-link">View all 45+ tools →</a>
      </div>

      <div class="tools-grid">
        {tier1Tools.map((tool) => (
          <a href={`/${tool.slug}/`} class="tool-card">
            <div class="tool-card-top">
              <span class="tool-card-title">{tool.name}</span>
              <span class="tool-card-badge">Tier 1</span>
            </div>
            <p class="tool-card-desc">{tool.shortDescription}</p>
            <span class="tool-card-action">Calculate now →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Popular Evergreen Section -->
    <section class="home-section" aria-labelledby="heading-popular">
      <div class="section-header">
        <div>
          <span class="section-tag">Most Used</span>
          <h2 id="heading-popular" class="section-heading">Evergreen Everyday Calculators</h2>
        </div>
      </div>

      <div class="tools-grid">
        {popularTools.slice(0, 8).map((tool) => (
          <a href={`/${tool.slug}/`} class="tool-card">
            <div class="tool-card-top">
              <span class="tool-card-title">{tool.name}</span>
              <span class="tool-card-badge" style="background: var(--color-success-light); color: var(--color-success);">Popular</span>
            </div>
            <p class="tool-card-desc">{tool.shortDescription}</p>
            <span class="tool-card-action">Calculate now →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Financial Calculators Category Strip -->
    <section class="home-section" aria-labelledby="heading-cat-finance">
      <div class="section-header">
        <div>
          <span class="section-tag" style="background-color: var(--color-primary-light); color: var(--color-primary);">Personal Finance</span>
          <h2 id="heading-cat-finance" class="section-heading">Financial & Loan Calculators</h2>
          <p class="section-subtext">{CATEGORIES.financial.description}</p>
        </div>
        <a href="/financial-calculators/" class="section-link">Explore all {financeTools.length} financial tools →</a>
      </div>

      <div class="tools-grid">
        {financeTools.slice(0, 6).map((tool) => (
          <a href={`/${tool.slug}/`} class="tool-card">
            <div class="tool-card-top">
              <span class="tool-card-title">{tool.name}</span>
            </div>
            <p class="tool-card-desc">{tool.shortDescription}</p>
            <span class="tool-card-action">Calculate now →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Fitness & Health Calculators Category Strip -->
    <section class="home-section" aria-labelledby="heading-cat-health">
      <div class="section-header">
        <div>
          <span class="section-tag" style="background-color: var(--color-success-light); color: var(--color-success);">Body & Wellness</span>
          <h2 id="heading-cat-health" class="section-heading">Fitness & Health Calculators</h2>
          <p class="section-subtext">{CATEGORIES.health.description}</p>
        </div>
        <a href="/fitness-health-calculators/" class="section-link">Explore all {healthTools.length} health tools →</a>
      </div>

      <div class="tools-grid">
        {healthTools.map((tool) => (
          <a href={`/${tool.slug}/`} class="tool-card">
            <div class="tool-card-top">
              <span class="tool-card-title">{tool.name}</span>
            </div>
            <p class="tool-card-desc">{tool.shortDescription}</p>
            <span class="tool-card-action">Calculate now →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Math Calculators Category Strip -->
    <section class="home-section" aria-labelledby="heading-cat-math">
      <div class="section-header">
        <div>
          <span class="section-tag" style="background-color: #f3e8ff; color: #7e22ce;">STEM & Academics</span>
          <h2 id="heading-cat-math" class="section-heading">Math & Academic Calculators</h2>
          <p class="section-subtext">{CATEGORIES.math.description}</p>
        </div>
        <a href="/math-calculators/" class="section-link">Explore all {mathTools.length} math tools →</a>
      </div>

      <div class="tools-grid">
        {mathTools.slice(0, 6).map((tool) => (
          <a href={`/${tool.slug}/`} class="tool-card">
            <div class="tool-card-top">
              <span class="tool-card-title">{tool.name}</span>
            </div>
            <p class="tool-card-desc">{tool.shortDescription}</p>
            <span class="tool-card-action">Calculate now →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Everyday Tools Category Strip -->
    <section class="home-section" aria-labelledby="heading-cat-everyday">
      <div class="section-header">
        <div>
          <span class="section-tag" style="background-color: #ffedd5; color: #c2410c;">Daily Utilities</span>
          <h2 id="heading-cat-everyday" class="section-heading">Everyday Tools & Converters</h2>
          <p class="section-subtext">{CATEGORIES.everyday.description}</p>
        </div>
        <a href="/everyday-tools/" class="section-link">Explore all {everydayTools.length} everyday tools →</a>
      </div>

      <div class="tools-grid">
        {everydayTools.map((tool) => (
          <a href={`/${tool.slug}/`} class="tool-card">
            <div class="tool-card-top">
              <span class="tool-card-title">{tool.name}</span>
            </div>
            <p class="tool-card-desc">{tool.shortDescription}</p>
            <span class="tool-card-action">Open hub →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Calculation Guides / Blog Section -->
    <section class="home-section" aria-labelledby="heading-guides">
      <div class="section-header">
        <div>
          <span class="section-tag">In-Depth Explanations</span>
          <h2 id="heading-guides" class="section-heading">Calculation Guides & Formulas</h2>
        </div>
        <a href="/blog/" class="section-link">View all guides →</a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {blogPosts.map((post) => (
          <article style="background: var(--color-white); border: 1px solid var(--color-slate-200); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="font-size: 0.8rem; color: var(--color-slate-500); margin-bottom: 0.5rem;">
                {post.publishDate} • {post.readingTime}
              </div>
              <h3 style="font-size: 1.15rem; margin-top: 0; margin-bottom: 0.75rem;">
                <a href={`/${post.slug}/`} style="color: var(--color-slate-900); text-decoration: none;">{post.title}</a>
              </h3>
              <p style="font-size: 0.9rem; color: var(--color-slate-600); line-height: 1.5;">{post.summary}</p>
            </div>
            <div style="margin-top: 1.25rem;">
              <a href={`/${post.slug}/`} style="font-weight: 600; font-size: 0.9rem;">Read complete guide →</a>
            </div>
          </article>
        ))}

        <!-- Featured Percentage Calculator Upgraded Tool Card -->
        <article style="background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%); border: 1.5px solid var(--color-primary-border); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span style="background: var(--color-primary); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); text-transform: uppercase;">Upgraded Tool Page</span>
            <h3 style="font-size: 1.15rem; margin: 0.75rem 0 0.5rem;">
              <a href="/percentage-calculator/" style="color: var(--color-slate-900); text-decoration: none;">Percentage Calculator (Full Tool)</a>
            </h3>
            <p style="font-size: 0.9rem; color: var(--color-slate-600); line-height: 1.5;">
              Upgraded with full interactive calculators for percentage of a number, percentage increase/decrease, and percentage difference.
            </p>
          </div>
          <div style="margin-top: 1.25rem;">
            <a href="/percentage-calculator/" class="btn btn-primary btn-sm" style="text-decoration: none; color: #fff;">Open Tool Page →</a>
          </div>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-section {
    margin-bottom: 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-slate-200);
    padding-bottom: 1rem;
  }

  .section-tag {
    display: inline-block;
    background-color: var(--color-slate-100);
    color: var(--color-slate-700);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.35rem;
  }

  .section-heading {
    font-size: 1.65rem;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .section-subtext {
    font-size: 0.925rem;
    color: var(--color-slate-600);
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  .section-link {
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .tool-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .tool-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tool-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .tool-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-slate-900);
    line-height: 1.3;
  }

  .tool-card-badge {
    font-size: 0.7rem;
    font-weight: 700;
    background-color: #fef3c7;
    color: #92400e;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .tool-card-desc {
    font-size: 0.85rem;
    color: var(--color-slate-600);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .tool-card-action {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
