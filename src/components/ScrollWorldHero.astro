---
import { popularTools } from '../data/calculators';

// Popular evergreen tools for immediate one-click access
const heroPopular = popularTools.slice(0, 7);
---

<section class="hero-section" id="hero-interactive-world" aria-label="AIO Calculator Interactive 3D World">
  <!-- Top Content: Badge, H1, Description, Live Search & Popular Tools -->
  <div class="container hero-content-top">
    <div class="hero-badge">
      <span class="badge-pulse"></span>
      100+ Free Online Calculators
    </div>

    <h1 class="hero-title">Free Online Calculators for Every Decision</h1>

    <p class="hero-lead">
      Fast, free, and accurate online calculators for personal finance, health &amp; fitness, mathematics, and daily utility. All calculations execute instantly in your browser with zero sign-up, zero paywalls, and complete data privacy.
    </p>

    <!-- Prominent Homepage Live Search Box -->
    <div class="hero-search-wrapper">
      <form action="/all-tools/" method="get" class="hero-search-form" role="search">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          name="q"
          id="hero-search-input"
          class="hero-search-input"
          placeholder="Search 45+ calculators (e.g. Mortgage, BMI, Calorie, GPA, Compound Interest)..."
          autocomplete="off"
        />
        <button type="submit" class="btn btn-primary hero-search-btn">Search</button>
      </form>
    </div>

    <!-- Evergreen Popular Calculators Shortcuts -->
    <div class="hero-popular-strip">
      <span class="popular-label">Popular:</span>
      <div class="popular-pills">
        <a href="/mortgage-calculator/" class="popular-pill">Mortgage</a>
        <a href="/bmi-ideal-weight-calculator/" class="popular-pill">BMI &amp; Ideal Weight</a>
        <a href="/calorie-macro-calculator/" class="popular-pill">Calorie &amp; Macro</a>
        <a href="/compound-interest-calculator/" class="popular-pill">Compound Interest</a>
        <a href="/basic-math-calculator/" class="popular-pill">Basic Math</a>
        <a href="/gpa-calculator/" class="popular-pill">GPA</a>
        <a href="/time-date-calculator/" class="popular-pill">Age &amp; Date</a>
      </div>
    </div>
  </div>

  <!-- 3D Calculator World Stage with Real Scrolling Effect -->
  <div class="container hero-3d-stage-wrapper">
    <div class="world-stage-header">
      <div class="stage-tabs" role="tablist" aria-label="3D Calculator Districts">
        <button class="stage-tab active" data-district="0" role="tab" aria-selected="true">
          <span class="tab-icon">💰</span> 1. Finance District
        </button>
        <button class="stage-tab" data-district="1" role="tab" aria-selected="false">
          <span class="tab-icon">❤️</span> 2. Health &amp; Fitness
        </button>
        <button class="stage-tab" data-district="2" role="tab" aria-selected="false">
          <span class="tab-icon">📐</span> 3. Math &amp; Science
        </button>
        <button class="stage-tab" data-district="3" role="tab" aria-selected="false">
          <span class="tab-icon">⏱️</span> 4. Everyday Utility
        </button>
        <button class="stage-tab" data-district="4" role="tab" aria-selected="false">
          <span class="tab-icon">🌐</span> 5. All Tools Core
        </button>
      </div>

      <div class="stage-controls">
        <span class="scroll-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
          Scroll page to fly
        </span>
        <button id="world-3d-toggle-btn" class="world-toggle-btn" type="button" aria-label="Toggle auto flight">
          <span id="world-3d-icon">⏸</span>
          <span id="world-3d-label">Pause</span>
        </button>
      </div>
    </div>

    <!-- 3D Perspective Viewport -->
    <div class="world-3d-viewport" id="world-viewport">
      <!-- District 1: Finance -->
      <div class="district-scene active" id="district-0">
        <div class="diorama-card">
          <div class="diorama-3d-visual">
            <svg viewBox="0 0 440 260" class="diorama-svg" aria-hidden="true">
              <defs>
                <linearGradient id="finTileGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#1e3a8a" />
                  <stop offset="100%" stop-color="#3b82f6" />
                </linearGradient>
                <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#fbbf24" />
                  <stop offset="100%" stop-color="#d97706" />
                </linearGradient>
                <filter id="cardShadow" x="-10%" y="-10%" width="130%" height="130%">
                  <feDropShadow dx="0" dy="8" stdDeviation="6" flood-opacity="0.15" />
                </filter>
              </defs>
              <!-- 3D Isometric Base Slab -->
              <polygon points="220,25 410,120 220,215 30,120" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="2" />
              <polygon points="30,120 220,215 220,230 30,135" fill="#94a3b8" />
              <polygon points="220,215 410,120 410,135 220,230" fill="#64748b" />

              <!-- 3D Amortization Growth Bar 1 -->
              <polygon points="120,110 150,95 150,155 120,170" fill="#2563eb" />
              <polygon points="150,95 175,108 175,168 150,155" fill="#1d4ed8" />
              <polygon points="120,110 150,95 175,108 145,123" fill="#60a5fa" />

              <!-- 3D Amortization Growth Bar 2 (Higher) -->
              <polygon points="180,80 210,65 210,155 180,170" fill="#2563eb" />
              <polygon points="210,65 235,78 235,168 210,155" fill="#1d4ed8" />
              <polygon points="180,80 210,65 235,78 205,93" fill="#93c5fd" />

              <!-- 3D Amortization Growth Bar 3 (Peak) -->
              <polygon points="240,50 270,35 270,155 240,170" fill="#10b981" />
              <polygon points="270,35 295,48 295,168 270,155" fill="#047857" />
              <polygon points="240,50 270,35 295,48 265,63" fill="#34d399" />

              <!-- Floating Credit Card -->
              <g filter="url(#cardShadow)" class="floating-item-1">
                <rect x="70" y="45" width="85" height="52" rx="6" fill="#1e293b" transform="rotate(-8 112 71)" />
                <rect x="73" y="62" width="79" height="10" fill="#475569" transform="rotate(-8 112 71)" />
                <circle cx="135" cy="85" r="7" fill="#ef4444" opacity="0.85" />
                <circle cx="143" cy="85" r="7" fill="#f59e0b" opacity="0.85" />
              </g>

              <!-- Stack of Gold Compounding Coins -->
              <g class="floating-item-2">
                <ellipse cx="330" cy="110" rx="24" ry="12" fill="#b45309" />
                <ellipse cx="330" cy="104" rx="24" ry="12" fill="url(#goldGrad)" />
                <ellipse cx="330" cy="94" rx="24" ry="12" fill="#b45309" />
                <ellipse cx="330" cy="88" rx="24" ry="12" fill="url(#goldGrad)" />
                <ellipse cx="330" cy="78" rx="24" ry="12" fill="#b45309" />
                <ellipse cx="330" cy="72" rx="24" ry="12" fill="url(#goldGrad)" />
                <text x="330" y="76" font-size="11" font-weight="bold" fill="#78350f" text-anchor="middle">$</text>
              </g>
            </svg>
          </div>
          <div class="diorama-info">
            <span class="diorama-tag">District 01 • Financial Engineering</span>
            <h3 class="diorama-heading">Personal &amp; Loan Finance Realm</h3>
            <p class="diorama-desc">
              Calculate exact monthly obligations, compare compounding frequencies, forecast retirement corpora, and optimize debt payoff with 100% mathematical precision.
            </p>
            <div class="diorama-quick-links">
              <a href="/mortgage-calculator/" class="quick-link-pill">Mortgage PITI</a>
              <a href="/emi-calculator/" class="quick-link-pill">EMI Calculator</a>
              <a href="/sip-investment-planner/" class="quick-link-pill">SIP Planner</a>
              <a href="/financial-calculators/" class="quick-link-pill more">View All 14 Tools →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- District 2: Health & Fitness -->
      <div class="district-scene" id="district-1">
        <div class="diorama-card">
          <div class="diorama-3d-visual">
            <svg viewBox="0 0 440 260" class="diorama-svg" aria-hidden="true">
              <!-- 3D Base Slab (Green Hue) -->
              <polygon points="220,25 410,120 220,215 30,120" fill="#dcfce7" stroke="#bbf7d0" stroke-width="2" />
              <polygon points="30,120 220,215 220,230 30,135" fill="#86efac" />
              <polygon points="220,215 410,120 410,135 220,230" fill="#4ade80" />

              <!-- Isometric Running Oval & Caliper Platform -->
              <ellipse cx="220" cy="120" rx="130" ry="60" fill="none" stroke="#f43f5e" stroke-width="8" stroke-dasharray="14 8" />
              <ellipse cx="220" cy="120" rx="90" ry="40" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" />

              <!-- 3D Heart Rate Pulse Display -->
              <g class="floating-item-1">
                <rect x="145" y="55" width="150" height="70" rx="8" fill="#1e293b" />
                <polyline points="160,90 185,90 195,70 205,110 215,80 225,95 235,90 275,90" fill="none" stroke="#10b981" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="280" cy="70" r="5" fill="#ef4444" />
              </g>

              <!-- 3D Isometric Dumbbell Weight -->
              <g class="floating-item-2">
                <polygon points="80,130 110,115 110,155 80,170" fill="#334155" />
                <polygon points="110,115 125,123 125,163 110,155" fill="#1e293b" />
                <rect x="110" y="135" width="50" height="8" fill="#94a3b8" transform="rotate(-20 135 139)" />
                <polygon points="145,108 175,93 175,133 145,148" fill="#334155" />
              </g>

              <!-- Calorie Energy Flame -->
              <g class="floating-item-1">
                <circle cx="340" cy="95" r="26" fill="#fed7aa" />
                <path d="M340 75 C345 85 355 92 355 102 C355 110 348 116 340 116 C332 116 325 110 325 102 C325 94 332 88 340 75 Z" fill="#f97316" />
                <path d="M340 85 C343 92 348 96 348 102 C348 106 344 110 340 110 C336 110 332 106 332 102 C332 98 335 94 340 85 Z" fill="#fbbf24" />
              </g>
            </svg>
          </div>
          <div class="diorama-info">
            <span class="diorama-tag" style="color: #059669; background-color: #ecfdf5;">District 02 • Biometric Precision</span>
            <h3 class="diorama-heading">Health &amp; Metabolism Realm</h3>
            <p class="diorama-desc">
              Calculate your exact body mass index, Navy body fat percentage, Mifflin-St Jeor daily energy expenditure (TDEE), and pregnancy milestones with clinical formulas.
            </p>
            <div class="diorama-quick-links">
              <a href="/bmi-ideal-weight-calculator/" class="quick-link-pill">BMI &amp; Weight</a>
              <a href="/calorie-macro-calculator/" class="quick-link-pill">TDEE &amp; Macros</a>
              <a href="/calorie-intake-deficit-tracker/" class="quick-link-pill">Deficit Tracker</a>
              <a href="/fitness-health-calculators/" class="quick-link-pill more">View All 8 Tools →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- District 3: Math & Science -->
      <div class="district-scene" id="district-2">
        <div class="diorama-card">
          <div class="diorama-3d-visual">
            <svg viewBox="0 0 440 260" class="diorama-svg" aria-hidden="true">
              <!-- 3D Base Slab (Slate Blue) -->
              <polygon points="220,25 410,120 220,215 30,120" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="2" />
              <polygon points="30,120 220,215 220,230 30,135" fill="#94a3b8" />
              <polygon points="220,215 410,120 410,135 220,230" fill="#64748b" />

              <!-- Giant 3D Isometric Desktop Calculator with Tactile Buttons -->
              <g class="floating-item-1">
                <polygon points="130,70 230,20 290,50 190,100" fill="#334155" />
                <polygon points="190,100 290,50 290,110 190,160" fill="#1e293b" />
                <polygon points="130,70 190,100 190,160 130,130" fill="#0f172a" />
                <!-- Screen -->
                <polygon points="160,65 220,35 250,50 190,80" fill="#047857" />
                <text x="215" y="60" font-family="monospace" font-size="11" font-weight="bold" fill="#34d399" transform="rotate(-15 215 60)">3.14159</text>
              </g>

              <!-- Floating 3D Geometric Cone & Sphere -->
              <g class="floating-item-2">
                <circle cx="340" cy="80" r="26" fill="url(#finTileGrad)" />
                <ellipse cx="340" cy="80" rx="26" ry="10" fill="none" stroke="#93c5fd" stroke-width="1.5" />
                <polygon points="90,140 120,70 150,140" fill="#f59e0b" opacity="0.85" />
                <ellipse cx="120" cy="140" rx="30" ry="12" fill="#d97706" opacity="0.85" />
              </g>

              <!-- Floating Math Symbols -->
              <text x="75" y="60" font-family="serif" font-size="28" font-weight="bold" fill="#2563eb" class="floating-item-1">∑</text>
              <text x="350" y="160" font-family="serif" font-size="28" font-weight="bold" fill="#7c3aed" class="floating-item-2">√x</text>
              <text x="210" y="195" font-family="monospace" font-size="14" font-weight="bold" fill="#059669">ax² + bx + c = 0</text>
            </svg>
          </div>
          <div class="diorama-info">
            <span class="diorama-tag" style="color: #2563eb; background-color: #eff6ff;">District 03 • Exact Science</span>
            <h3 class="diorama-heading">Math &amp; Equations Realm</h3>
            <p class="diorama-desc">
              Solve complex algebra, determine polynomial roots, calculate 3D geometric surface volumes, run statistical standard deviations, and compute combinatorial probabilities.
            </p>
            <div class="diorama-quick-links">
              <a href="/basic-math-calculator/" class="quick-link-pill">Basic Math</a>
              <a href="/algebra-equations-calculator/" class="quick-link-pill">Algebra &amp; Roots</a>
              <a href="/geometry-calculator/" class="quick-link-pill">3D Geometry</a>
              <a href="/math-calculators/" class="quick-link-pill more">View All 10 Tools →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- District 4: Everyday Utility -->
      <div class="district-scene" id="district-3">
        <div class="diorama-card">
          <div class="diorama-3d-visual">
            <svg viewBox="0 0 440 260" class="diorama-svg" aria-hidden="true">
              <!-- 3D Base Slab (Warm Amber/Gray) -->
              <polygon points="220,25 410,120 220,215 30,120" fill="#fef3c7" stroke="#fde68a" stroke-width="2" />
              <polygon points="30,120 220,215 220,230 30,135" fill="#f59e0b" />
              <polygon points="220,215 410,120 410,135 220,230" fill="#d97706" />

              <!-- 3D Analog Clock / Chronometer Gears -->
              <g class="floating-item-1">
                <circle cx="160" cy="90" r="38" fill="#1e293b" />
                <circle cx="160" cy="90" r="33" fill="#ffffff" />
                <line x1="160" y1="90" x2="160" y2="68" stroke="#1e293b" stroke-width="3" stroke-linecap="round" />
                <line x1="160" y1="90" x2="178" y2="90" stroke="#ef4444" stroke-width="2" stroke-linecap="round" />
                <circle cx="160" cy="90" r="4" fill="#0f172a" />
              </g>

              <!-- 3D Isometric Calendar Cube -->
              <g class="floating-item-2">
                <polygon points="260,70 310,45 350,65 300,90" fill="#ef4444" />
                <polygon points="300,90 350,65 350,115 300,140" fill="#e2e8f0" />
                <polygon points="260,70 300,90 300,140 260,120" fill="#cbd5e1" />
                <text x="315" y="115" font-family="sans-serif" font-size="20" font-weight="900" fill="#0f172a">30</text>
              </g>

              <!-- Speedometer & Fuel Gauge -->
              <g class="floating-item-1">
                <path d="M70,160 A40,40 0 0,1 130,160" fill="none" stroke="#0f172a" stroke-width="8" stroke-linecap="round" />
                <path d="M70,160 A40,40 0 0,1 110,130" fill="none" stroke="#10b981" stroke-width="8" stroke-linecap="round" />
                <line x1="100" y1="160" x2="115" y2="135" stroke="#ef4444" stroke-width="3" stroke-linecap="round" />
              </g>
            </svg>
          </div>
          <div class="diorama-info">
            <span class="diorama-tag" style="color: #b45309; background-color: #fffbeb;">District 04 • Daily Practicality</span>
            <h3 class="diorama-heading">Everyday Tools &amp; Life Realm</h3>
            <p class="diorama-desc">
              Calculate exact days between calendar dates, convert units across international metrics, estimate fuel trip expenses, split restaurant checks, and generate secure passwords.
            </p>
            <div class="diorama-quick-links">
              <a href="/time-date-calculator/" class="quick-link-pill">Age &amp; Date</a>
              <a href="/unit-conversion-calculator/" class="quick-link-pill">Unit Converter</a>
              <a href="/sleep-calculator/" class="quick-link-pill">Sleep Cycles</a>
              <a href="/everyday-tools/" class="quick-link-pill more">View All 10 Tools →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- District 5: Central Core Hub -->
      <div class="district-scene" id="district-4">
        <div class="diorama-card finale-card">
          <div class="diorama-3d-visual">
            <svg viewBox="0 0 440 260" class="diorama-svg" aria-hidden="true">
              <!-- Central Glowing Core -->
              <circle cx="220" cy="120" r="65" fill="#1d4ed8" opacity="0.15" />
              <circle cx="220" cy="120" r="50" fill="#2563eb" />
              <!-- Orbit Rings -->
              <ellipse cx="220" cy="120" rx="140" ry="45" fill="none" stroke="#3b82f6" stroke-width="2" stroke-dasharray="8 6" />
              <ellipse cx="220" cy="120" rx="45" ry="110" fill="none" stroke="#60a5fa" stroke-width="2" stroke-dasharray="8 6" transform="rotate(30 220 120)" />

              <!-- Orbiting Category Planets -->
              <g class="floating-item-1">
                <circle cx="85" cy="115" r="22" fill="#1e40af" />
                <text x="85" y="120" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Finance</text>
              </g>

              <g class="floating-item-2">
                <circle cx="355" cy="125" r="22" fill="#059669" />
                <text x="355" y="130" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Health</text>
              </g>

              <g class="floating-item-1">
                <circle cx="170" cy="35" r="22" fill="#7c3aed" />
                <text x="170" y="40" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Math</text>
              </g>

              <g class="floating-item-2">
                <circle cx="270" cy="205" r="22" fill="#d97706" />
                <text x="270" y="210" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">Utility</text>
              </g>

              <text x="220" y="126" font-size="16" font-weight="900" fill="#ffffff" text-anchor="middle">AIO</text>
            </svg>
          </div>
          <div class="diorama-info">
            <span class="diorama-tag" style="color: #4338ca; background-color: #eef2ff;">Central Finale • All Systems</span>
            <h3 class="diorama-heading">The Complete Calculator Suite</h3>
            <p class="diorama-desc">
              All 45+ verified calculators united in a single, lightning-fast, zero-tracking web application.
            </p>
            <div class="diorama-quick-links">
              <a href="/all-tools/" class="btn btn-primary btn-sm" style="color: #ffffff; text-decoration: none;">Open Complete 45+ Tools Catalog →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: radial-gradient(circle at 50% 10%, #eff6ff 0%, #ffffff 75%);
    border-bottom: 1px solid var(--color-slate-200);
    padding: 3rem 0 2.5rem;
  }

  .hero-content-top {
    text-align: center;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
    border: 1px solid var(--color-primary-border);
  }

  .badge-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.25);
    animation: badgePulse 2s infinite;
  }

  @keyframes badgePulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(29, 78, 216, 0.5); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(29, 78, 216, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(29, 78, 216, 0); }
  }

  .hero-title {
    font-size: 2.75rem;
    letter-spacing: -0.035em;
    font-weight: 850;
    color: var(--color-slate-900);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2rem;
    }
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--color-slate-600);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Search Bar */
  .hero-search-wrapper {
    max-width: 660px;
    margin: 0 auto 1.5rem;
  }

  .hero-search-form {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    color: var(--color-slate-400);
    pointer-events: none;
  }

  .hero-search-input {
    width: 100%;
    min-height: 56px;
    padding: 0.75rem 7.5rem 0.75rem 3.25rem;
    font-size: 1.05rem;
    border: 2px solid var(--color-slate-300);
    border-radius: var(--radius-full);
    background-color: var(--color-white);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    transition: all 0.15s ease;
  }

  .hero-search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(29, 78, 216, 0.15);
  }

  .hero-search-btn {
    position: absolute;
    right: 0.4rem;
    min-height: 46px;
    padding: 0.5rem 1.4rem;
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  /* Popular Pills */
  .hero-popular-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.875rem;
  }

  .popular-label {
    font-weight: 700;
    color: var(--color-slate-500);
  }

  .popular-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }

  .popular-pill {
    padding: 0.35rem 0.75rem;
    background-color: var(--color-white);
    color: var(--color-slate-700);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .popular-pill:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  /* 3D World Stage Wrapper */
  .hero-3d-stage-wrapper {
    max-width: 960px;
    margin: 1rem auto 0;
  }

  .world-stage-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-slate-200);
  }

  .stage-tabs {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .stage-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    background-color: var(--color-slate-100);
    border: 1px solid var(--color-slate-200);
    color: var(--color-slate-700);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .stage-tab:hover {
    background-color: var(--color-slate-200);
    color: var(--color-slate-900);
  }

  .stage-tab.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(29, 78, 216, 0.25);
  }

  .stage-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-slate-500);
  }

  .scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--color-slate-500);
  }

  .world-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 1px solid var(--color-slate-300);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--color-slate-700);
    font-weight: 600;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .world-toggle-btn:hover {
    background-color: var(--color-slate-100);
    border-color: var(--color-slate-400);
  }

  /* 3D Perspective Viewport */
  .world-3d-viewport {
    perspective: 1200px;
    min-height: 340px;
    position: relative;
    overflow: hidden;
  }

  .district-scene {
    display: none;
    width: 100%;
    opacity: 0;
    transform: rotateX(10deg) translateZ(-40px) scale(0.96);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .district-scene.active {
    display: block;
    opacity: 1;
    transform: rotateX(0deg) translateZ(0) scale(1);
  }

  .diorama-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    background-color: #ffffff;
    border: 1.5px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    padding: 1.5rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .diorama-card {
      grid-template-columns: 1.15fr 1fr;
      padding: 2rem;
    }
  }

  .diorama-svg {
    width: 100%;
    height: auto;
    max-height: 250px;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.08));
    transition: transform 0.3s ease;
  }

  .diorama-card:hover .diorama-svg {
    transform: translateY(-4px) scale(1.02);
  }

  /* Floating animations inside SVGs */
  .floating-item-1 {
    animation: floatSlow 3.8s ease-in-out infinite alternate;
  }

  .floating-item-2 {
    animation: floatMedium 4.5s ease-in-out infinite alternate-reverse;
  }

  @keyframes floatSlow {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-7px); }
  }

  @keyframes floatMedium {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-9px) rotate(1deg); }
  }

  .diorama-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.5rem;
  }

  .diorama-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-slate-900);
    margin: 0.25rem 0 0.5rem;
  }

  .diorama-desc {
    font-size: 0.95rem;
    color: var(--color-slate-600);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .diorama-quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .quick-link-pill {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-slate-100);
    color: var(--color-slate-800);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .quick-link-pill:hover {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .quick-link-pill.more {
    background: none;
    color: var(--color-primary);
    padding-left: 0;
  }
</style>

<script>
  // 3D Calculator Stage Interactive Controller (Scroll Scrubbing + Auto-Rotation)
  document.addEventListener('DOMContentLoaded', () => {
    const scenes = document.querySelectorAll('.district-scene');
    const tabs = document.querySelectorAll('.stage-tab');
    const toggleBtn = document.getElementById('world-3d-toggle-btn');
    const toggleIcon = document.getElementById('world-3d-icon');
    const toggleLabel = document.getElementById('world-3d-label');
    const hero = document.getElementById('hero-interactive-world');
    const viewport = document.getElementById('world-viewport');

    let currentDistrict = 0;
    let isPlaying = true;
    let autoTimer: any = null;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      isPlaying = false;
      if (toggleIcon) toggleIcon.textContent = '▶';
      if (toggleLabel) toggleLabel.textContent = 'Play';
    }

    function switchDistrict(index: number) {
      currentDistrict = (index + scenes.length) % scenes.length;

      scenes.forEach((scene, i) => {
        if (i === currentDistrict) {
          scene.classList.add('active');
        } else {
          scene.classList.remove('active');
        }
      });

      tabs.forEach((tab, i) => {
        if (i === currentDistrict) {
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
        } else {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        }
      });
    }

    function startAutoFlight() {
      if (!isPlaying || prefersReducedMotion) return;
      clearInterval(autoTimer);
      autoTimer = setInterval(() => {
        switchDistrict(currentDistrict + 1);
      }, 4000);
    }

    function pauseFlight() {
      isPlaying = false;
      clearInterval(autoTimer);
      if (toggleIcon) toggleIcon.textContent = '▶';
      if (toggleLabel) toggleLabel.textContent = 'Play';
    }

    function resumeFlight() {
      isPlaying = true;
      if (toggleIcon) toggleIcon.textContent = '⏸';
      if (toggleLabel) toggleLabel.textContent = 'Pause';
      startAutoFlight();
    }

    toggleBtn?.addEventListener('click', () => {
      if (isPlaying) {
        pauseFlight();
      } else {
        resumeFlight();
      }
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        switchDistrict(i);
        pauseFlight();
      });
    });

    // Authentic Scrolling Effect:
    // As user scrolls down the hero section, the 3D stage advances through the 5 calculator districts!
    window.addEventListener('scroll', () => {
      if (!hero) return;
      const rect = hero.getBoundingClientRect();
      const heroHeight = rect.height;

      // When hero is within active scroll viewport
      if (rect.top <= 50 && rect.bottom >= 150) {
        const scrollProgress = Math.min(1, Math.max(0, -rect.top / (heroHeight * 0.75)));
        const targetDistrict = Math.min(scenes.length - 1, Math.floor(scrollProgress * scenes.length));
        
        if (targetDistrict !== currentDistrict) {
          switchDistrict(targetDistrict);
        }
      }
    }, { passive: true });

    // Interactive 3D Mouse Parallax (Tilts the diorama slightly on cursor movement)
    if (viewport && !prefersReducedMotion) {
      viewport.addEventListener('mousemove', (e) => {
        const rect = viewport.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        const rotateX = (-y / rect.height) * 8;
        const rotateY = (x / rect.width) * 8;

        const activeCard = viewport.querySelector('.district-scene.active .diorama-card') as HTMLElement | null;
        if (activeCard) {
          activeCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        }
      });

      viewport.addEventListener('mouseleave', () => {
        const activeCard = viewport.querySelector('.district-scene.active .diorama-card') as HTMLElement | null;
        if (activeCard) {
          activeCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
        }
      });
    }

    if (isPlaying) {
      startAutoFlight();
    }
  });
</script>
